# Caddy configuration for reverse proxy
# Update YOURDOMAIN.COM with your actual domain (gedevops.site)

gedevops.site {
    # Redirect HTTP to HTTPS (automatic)

    # Optional: API endpoint if you add HTTP API to Node app
    # reverse_proxy /api localhost:3000

    # TLS certificate auto-renewal with Let's Encrypt
    tls {
        dns route53  # If using AWS Route53, or remove for HTTP challenge
    }

    # Logs
    log {
        output file /data/access.log
    }
}

# Development: Allow local HTTP access
:8000 {
    reverse_proxy agente-wa:3000
}
