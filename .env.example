# WhatsApp Agent Configuration
NODE_ENV=development
LOG_LEVEL=info

# Monitor Telegram (npm run monitor)
# Crear bot: hablar con @BotFather → /newbot → copiar token
TELEGRAM_BOT_TOKEN=
# Obtener chat id: escribe al bot y ejecuta npm run telegram:chat-id
TELEGRAM_CHAT_ID=
# Rutas personalizadas (opcional; por defecto Psic_logo_Aras y Candy)
# MONITOR_CHAT_FILES=/ruta/Psic_logo_Aras/chat.txt,/ruta/Candy/chat.txt
# MONITOR_CHAT_FILE=/ruta/absoluta/chat.txt
# MONITOR_POLL_MS=2000

# Multi-teléfono: cambiar estos valores y reiniciar Docker para cambiar de teléfono
# Teléfono 1 (default): dejar sin definir o usar ./conversations y ./auth_info
# Teléfono 2: CONVERSATIONS_DIR=./conversations_phone2  AUTH_DIR=./auth_info_phone2
# CONVERSATIONS_DIR=./conversations
# AUTH_DIR=./auth_info
