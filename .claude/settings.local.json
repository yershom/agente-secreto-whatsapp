{
  "permissions": {
    "allow": [
      "Bash(Get-ChildItem -Path . -Force)",
      "Bash(Select-Object Name, FullName)",
      "PowerShell(git init *)",
      "PowerShell(Get-ChildItem -Recurse -Depth 2 | Where-Object { $_.FullName -notmatch '\\\\.git|node_modules' } | Select-Object -ExpandProperty FullName)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(npm install *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(npm start *)",
      "PowerShell(git remote *)",
      "PowerShell(git *)"
    ]
  }
}
